# Server Configuration
NODE_ENV=development
# Vercel sets VERCEL_ENV automatically: development, preview or production.
# API docs are enabled locally and in preview, and disabled in production.
PORT=3000
# Browser-facing origin (the web app, including Vercel previews). Required in production.
APP_ORIGIN=https://localhost:3000

# Database Configuration
# Sensitive: get the value from a lead
# MONGODB_URI=

# File Storage (Cloudinary, DESIGN T-21)
CLOUDINARY_CLOUD_NAME=xt61jdbc
CLOUDINARY_API_KEY=
# Sensitive: never commit the real value
CLOUDINARY_API_SECRET=

# Email Sending (club Gmail, DESIGN T-22)
GMAIL_USER=colmandevclub@gmail.com
# Sensitive: never commit the real value
GMAIL_APP_PASSWORD=
