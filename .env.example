# Server Configuration
NODE_ENV=development
# Vercel sets VERCEL_ENV automatically: development, preview or production.
# API docs are enabled locally and in preview, and disabled in production.
PORT=3000
# Browser-facing origin (the web app, including Vercel previews). Required in production.
APP_ORIGIN=https://localhost:3000

# Database Configuration
# Use a separate database per environment:
# - development: dev_club
# - test: colman-devclub-test
# - production: colman-devclub-prod
# Keep this value secret and never log or print it in app output.
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/
# For local test databases, set a dedicated test URI and keep the name separate from prod.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/colman-devclub-test
# MONGO_URI_PROD=mongodb+srv://<user>:<password>@cluster.mongodb.net/colman-devclub-prod

# File Storage (Cloudinary, DESIGN T-21)
CLOUDINARY_CLOUD_NAME=xt61jdbc
CLOUDINARY_API_KEY=
# Sensitive: never commit the real value
CLOUDINARY_API_SECRET=

# Email Sending (club Gmail, DESIGN T-22)
GMAIL_USER=colmandevclub@gmail.com
# Sensitive: never commit the real value
GMAIL_APP_PASSWORD=
