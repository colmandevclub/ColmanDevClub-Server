# Server Configuration
NODE_ENV=development
# Vercel sets VERCEL_ENV automatically: development, preview or production.
# API docs are enabled locally and in preview, and disabled in production.
PORT=3000
# Browser-facing origin (the web app, including Vercel previews). Required in production.
APP_ORIGIN=https://localhost:3000

# Database Configuration
# MONGODB_URI=

# Email (T-22). Defaults: console locally/preview, test in tests, gmail in production.
# Console output includes metadata only; inspect bodies with TestEmailAdapter in tests.
# EMAIL_ADAPTER=console
# Required only with EMAIL_ADAPTER=gmail; use the club-owned account and an app password.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# pnpm dev:email opens a loopback-only template-sending tester, without accounts or DB.
